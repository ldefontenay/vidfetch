// VidFetch's windows, as dialog templates compiled by rc.exe.
//
// THREE RULES, ALL LOAD-BEARING. Tidying the layout can silently break them.
//
// 1. Every label comes IMMEDIATELY BEFORE the control it names, in this file.
//    Template order is tab order, and a screen reader takes a control's name
//    from the static text just before it. oleacc only looks backwards: a label
//    placed after its control leaves that control unnamed.
// 2. Every mnemonic (&x) is unique within a window. In the main window the
//    menu bar titles answer Alt+letter too, so they count (a unit test in
//    ui.rs checks this). Main window, in use:
//      Menus:     f File, d Download, y YouTube, g Category, o Options, h Help
//      Controls:  c Category, w Downloads (or a playlist's videos),
//                 p Play, n New download, u Update playlist, q Show queue,
//                 r Rename, x Show video in file explorer, l Delete, t Status
//    The YouTube window, in use:
//      Menus:     v Video, g Go, h Help
//      Controls:  w the list, p Play (or Open, or m Fetch more), d Download,
//                 s Search, c Close window, t Status
// 3. Every control reads correctly on its own. JAWS does not announce group
//    headings, so no label may depend on one, or on any other control.

#include <windows.h>

1 RT_MANIFEST "vidfetch.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Laurent Cadet de Fontenay"
            VALUE "FileDescription",  "An accessible interface for YouTube, and a downloader for other video sites"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "vidfetch"
            VALUE "LegalCopyright",   "MIT licensed"
            VALUE "OriginalFilename", "vidfetch.exe"
            VALUE "ProductName",      "VidFetch"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

