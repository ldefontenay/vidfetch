#define IDC_DELETE          1012
#define IDC_UPDATE          1013
#define IDC_QUEUE           1014
#define IDC_MESSAGE         1017
#define IDC_MESSAGE_LABEL   1018
#define IDC_MESSAGE_COPY    1019
#define IDC_ASK_TEXT        1020
#define IDC_N_NAME          1070
#define IDC_N_LABEL         1071
#define IDC_A_SOURCE        1090
