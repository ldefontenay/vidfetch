#define IDC_B_SEARCH        1121
#define IDC_B_CLOSE         1122
#define IDD_SEARCH          112
#define IDC_S_TEXT          1130
#define IDC_S_WHAT          1131
#define IDC_S_SORT          1132
#define IDC_S_LENGTH        1133
#define IDC_S_SHORTS        1134
#define IDM_RELATED         2055
#define IDM_COMMENTS        2056
#define IDM_TRANSCRIPT      2057
#define IDM_SEARCH_CHANNEL  2058

#define IDR_MENU            200
#define IDR_BROWSE          201

// Menu commands, in step with ui.rs. The lists of choices are filled in as
// they open, from the numbers in ui.rs.
#define IDM_FOLDER          2002
#define IDM_EXPLORER        2003
#define IDM_EXIT            2004
#define IDM_UPDATE_YTDLP    2005
#define IDM_STOP            2011
#define IDM_NUMBER          2012
#define IDM_CAPTIONS        2013
#define IDM_QUEUE           2014
#define IDM_CLEAR_QUEUE     2015
#define IDM_BACK            2016
#define IDM_EXTERNAL        2017
#define IDM_DOWNLOAD        2018
#define IDM_DESCRIBE        2019
#define IDM_MOVE            2020
#define IDM_SEARCH          2040
#define IDM_NEW_VIDEOS      2041
#define IDM_CHANNELS        2042
#define IDM_FOLLOW          2043
#define IDM_UNFOLLOW        2044
#define IDM_COPY            2045
#define IDM_BROWSER         2046
#define IDM_CHANNEL         2047
#define IDM_PLAYLISTS       2053
#define IDM_CLOSE           2054
#define IDM_NEW_CATEGORY    2050
#define IDM_RENAME_CATEGORY 2051
#define IDM_DELETE_CATEGORY 2052
#define IDM_PLAY_NEXT       2060
#define IDM_CUT_SILENCE     2061
#define IDM_OFFER_COPIED    2062
#define IDM_HISTORY         2048
#define IDM_CAPTIONS_TEXT   2049
#define IDM_ADD             2023
#define IDM_RENAME          2024
#define IDM_DELETE          2025
#define IDM_SHOW            2026
#define IDM_OPEN            2027
#define IDM_UPDATE          2028
#define IDM_HELP            2030
#define IDM_ABOUT           2031

// What has been downloaded, and what can be done to the one chosen. Enter
// plays it, or shows a playlist's videos in the same list, where Escape goes
// back; F2 renames and Delete deletes, from the list, which also has a
// context menu (Shift+F10 or the Applications key). What comes from YouTube
// has a window of its own, IDD_BROWSE. The list's label is set at run time
// to say which list it is, always with W as its letter. Every command is in the menus too.
// Delete is the last button, before the Status box, so overshooting by one
// stop cannot reach it.
IDD_MAIN DIALOGEX 0, 0, 400, 264
STYLE DS_SETFONT | WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "VidFetch"
MENU IDR_MENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "&Category:", -1, 7, 9, 70, 8
    COMBOBOX   IDC_CATEGORY, 80, 7, 313, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    LTEXT      "Do&wnloads, most recent first:", IDC_LIST_LABEL, 7, 25, 386, 8
    LISTBOX    IDC_LIST, 7, 35, 386, 120,
               LBS_NOTIFY | LBS_WANTKEYBOARDINPUT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_GROUP | WS_TABSTOP

    DEFPUSHBUTTON "&Play  Enter", IDC_OPEN, 7, 162, 190, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "&New download...  Ctrl+N", IDC_ADD, 203, 162, 190, 14, WS_TABSTOP
    PUSHBUTTON "&Update playlist  Ctrl+U", IDC_UPDATE, 7, 182, 190, 14, WS_TABSTOP
    PUSHBUTTON "Show &queue...  Ctrl+Q", IDC_QUEUE, 203, 182, 190, 14, WS_TABSTOP
    PUSHBUTTON "&Rename...  F2", IDC_RENAME, 7, 202, 190, 14, WS_TABSTOP
    PUSHBUTTON "Show video in file e&xplorer", IDC_SHOW, 203, 202, 190, 14, WS_TABSTOP
    PUSHBUTTON "De&lete...  Delete", IDC_DELETE, 7, 222, 190, 14, WS_TABSTOP

    LTEXT      "S&tatus:", -1, 7, 246, 30, 8
    EDITTEXT   IDC_STATUS, 40, 244, 353, 12, ES_AUTOHSCROLL | ES_READONLY | WS_GROUP | WS_TABSTOP
END

// Every command, with its shortcut, so that commands can be found without the
// help. Within each menu, every item's letter is unique.
IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New download...\tCtrl+N", IDM_ADD
        MENUITEM "Select &output folder...", IDM_FOLDER
        MENUITEM "Open library in file &explorer", IDM_EXPLORER
        MENUITEM "&Update yt-dlp", IDM_UPDATE_YTDLP
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4", IDM_EXIT
    END

    POPUP "&Download"
    BEGIN
        MENUITEM "&Open playlist / play video\tEnter", IDM_OPEN
        MENUITEM "Open video using default media &player", IDM_EXTERNAL
        MENUITEM "&Back\tBackspace", IDM_BACK
        MENUITEM "&Update playlist\tCtrl+U", IDM_UPDATE
        MENUITEM "Show d&escription\tCtrl+I", IDM_DESCRIBE
        MENUITEM "Show &captions", IDM_CAPTIONS_TEXT
        MENUITEM "Related v&ideos\tCtrl+R", IDM_RELATED
        MENUITEM "Comme&nts\tCtrl+K", IDM_COMMENTS
        MENUITEM "Tran&script\tCtrl+T", IDM_TRANSCRIPT
        MENUITEM SEPARATOR
        MENUITEM "Show &queue...\tCtrl+Q", IDM_QUEUE
        MENUITEM "E&mpty queue...", IDM_CLEAR_QUEUE
        MENUITEM "S&top download\tEscape", IDM_STOP
        MENUITEM SEPARATOR
        MENUITEM "&Rename...\tF2", IDM_RENAME
        MENUITEM "Mo&ve to category...\tCtrl+Shift+M", IDM_MOVE
        MENUITEM "Show video in file e&xplorer", IDM_SHOW
        MENUITEM "&Delete...\tDelete", IDM_DELETE
    END

    POPUP "&YouTube"
    BEGIN
        MENUITEM "&Search YouTube...\tCtrl+F", IDM_SEARCH
        MENUITEM "&New videos from channels\tCtrl+L", IDM_NEW_VIDEOS
        MENUITEM "&Your channels\tCtrl+Shift+L", IDM_CHANNELS
        MENUITEM "&Recently played\tCtrl+H", IDM_HISTORY
        MENUITEM SEPARATOR
        MENUITEM "&Follow channel", IDM_FOLLOW
        MENUITEM "&Unfollow channel...", IDM_UNFOLLOW
        MENUITEM "&Copy web address", IDM_COPY
        MENUITEM "Open in &browser", IDM_BROWSER
    END

    POPUP "Cate&gory"
    BEGIN
        MENUITEM "&New category...", IDM_NEW_CATEGORY
        MENUITEM "&Rename category...", IDM_RENAME_CATEGORY
        MENUITEM "&Delete category...", IDM_DELETE_CATEGORY
        MENUITEM SEPARATOR
        MENUITEM "&Move to category...\tCtrl+Shift+M", IDM_MOVE
    END

    POPUP "&Options"
    BEGIN
        POPUP "&Download as"
        BEGIN
            MENUITEM "-", 2100
        END
        POPUP "Picture &quality"
        BEGIN
            MENUITEM "-", 2200
        END
        MENUITEM "&Number playlist files in order", IDM_NUMBER
        MENUITEM "Save &captions file", IDM_CAPTIONS
        POPUP "Playing &speed"
        BEGIN
            MENUITEM "-", 2300
        END
        MENUITEM "Continuous &play", IDM_PLAY_NEXT
        MENUITEM "Cut si&lences when playing", IDM_CUT_SILENCE
        MENUITEM "Offer copied &web addresses", IDM_OFFER_COPIED
    END

    POPUP "&Help"
    BEGIN
        MENUITEM "&Help\tF1", IDM_HELP
        MENUITEM "&About VidFetch", IDM_ABOUT
    END
END

// The YouTube window's menus (online.rs). Items that cannot apply to the row
// chosen are greyed out as a menu opens.
IDR_BROWSE MENU
BEGIN
    POPUP "&Video"
    BEGIN
        MENUITEM "&Play or open\tEnter", IDM_OPEN
        MENUITEM "&Download\tCtrl+D", IDM_DOWNLOAD
        MENUITEM "Show d&escription\tCtrl+I", IDM_DESCRIBE
        MENUITEM "Related &videos\tCtrl+R", IDM_RELATED
        MENUITEM "Co&mments\tCtrl+K", IDM_COMMENTS
        MENUITEM "&Transcript\tCtrl+T", IDM_TRANSCRIPT
        MENUITEM "Show &channel", IDM_CHANNEL
        MENUITEM "Search t&his channel...\tCtrl+Shift+F", IDM_SEARCH_CHANNEL
        MENUITEM "Show channel's p&laylists", IDM_PLAYLISTS
        MENUITEM "&Follow channel", IDM_FOLLOW
        MENUITEM "&Unfollow channel...", IDM_UNFOLLOW
        MENUITEM "Cop&y web address", IDM_COPY
        MENUITEM "Open in &browser", IDM_BROWSER
        MENUITEM "&Remove from list\tDelete", IDM_DELETE
    END

    POPUP "&Go"
    BEGIN
        MENUITEM "&Search YouTube...\tCtrl+F", IDM_SEARCH
        MENUITEM "&New videos from channels\tCtrl+L", IDM_NEW_VIDEOS
        MENUITEM "&Your channels\tCtrl+Shift+L", IDM_CHANNELS
        MENUITEM "&Recently played\tCtrl+H", IDM_HISTORY
        MENUITEM SEPARATOR
        MENUITEM "&Back\tBackspace", IDM_BACK
        MENUITEM "&Close window", IDM_CLOSE
    END

    POPUP "&Help"
    BEGIN
        MENUITEM "&Help\tF1", IDM_HELP
    END
END

// The YouTube window (online.rs): search results, new videos, channels, a
// channel's videos and playlists, a playlist's videos, and what was played
// lately, one list at a time. Its title and the list's label are set at run
// time to say which list it is; the Enter button says what Enter does to
// the row chosen. Backspace goes back one list, closing the window from the
// first; Escape closes it from any list.
IDD_BROWSE DIALOGEX 0, 0, 400, 224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "YouTube - VidFetch"
MENU IDR_BROWSE
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "&What YouTube found:", IDC_LIST_LABEL, 7, 7, 386, 8
    LISTBOX    IDC_LIST, 7, 17, 386, 140,
               LBS_NOTIFY | LBS_WANTKEYBOARDINPUT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_GROUP | WS_TABSTOP

    DEFPUSHBUTTON "&Play  Enter", IDC_OPEN, 7, 164, 190, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "&Download  Ctrl+D", IDC_B_DOWNLOAD, 203, 164, 190, 14, WS_TABSTOP
    PUSHBUTTON "&Search...  Ctrl+F", IDC_B_SEARCH, 7, 184, 190, 14, WS_TABSTOP
    PUSHBUTTON "&Close window", IDC_B_CLOSE, 203, 184, 190, 14, WS_TABSTOP

    LTEXT      "S&tatus:", -1, 7, 206, 30, 8
    EDITTEXT   IDC_STATUS, 40, 204, 353, 12, ES_AUTOHSCROLL | ES_READONLY | WS_GROUP | WS_TABSTOP
END

// Search YouTube (searchbox.rs).
IDD_SEARCH DIALOGEX 0, 0, 260, 122
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search YouTube - VidFetch"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "&Search YouTube for:", -1, 7, 7, 246, 8
    EDITTEXT   IDC_S_TEXT, 7, 17, 246, 13, ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT      "&Look for:", -1, 7, 37, 90, 8
    COMBOBOX   IDC_S_WHAT, 100, 35, 153, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT      "S&ort results by:", -1, 7, 53, 90, 8
    COMBOBOX   IDC_S_SORT, 100, 51, 153, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT      "Length of &videos:", -1, 7, 69, 90, 8
    COMBOBOX   IDC_S_LENGTH, 100, 67, 153, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX "Leave out YouTube S&horts", IDC_S_SHORTS, 7, 85, 246, 10, WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON "Search", IDOK, 142, 102, 54, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 199, 102, 54, 14, WS_TABSTOP
END

IDD_MESSAGE DIALOGEX 0, 0, 304, 244
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VidFetch"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "&What happened:", IDC_MESSAGE_LABEL, 7, 7, 290, 8
    EDITTEXT   IDC_MESSAGE, 7, 19, 290, 198,
               ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON "C&opy all text", IDC_MESSAGE_COPY, 167, 223, 74, 14, WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 247, 223, 50, 14, WS_TABSTOP
END

// A question with two answers. The answers' wording, and which is the default
// for Enter, are set at run time: the safe answer is the default, and when it
// is "no" the buttons swap so that it comes first (message.rs).
IDD_ASK DIALOGEX 0, 0, 304, 180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VidFetch"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "&Question:", -1, 7, 7, 290, 8
    EDITTEXT   IDC_ASK_TEXT, 7, 19, 290, 134,
               ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Yes", IDOK, 7, 159, 143, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "No", IDCANCEL, 154, 159, 143, 14, WS_TABSTOP
END

IDD_NAME DIALOGEX 0, 0, 260, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename - VidFetch"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "&New name:", IDC_N_LABEL, 7, 7, 246, 8
    EDITTEXT   IDC_N_NAME, 7, 18, 246, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 149, 40, 50, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 203, 40, 50, 14, WS_TABSTOP
END

// A new download (addvideo.rs): a web address, how to download it, and what
// will happen. Letters: w, a, q, g, c, h, s, f; Cancel is Escape. Enter
// starts. Follow follows the channel of the address instead.
IDD_ADD DIALOGEX 0, 0, 400, 234
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New download - VidFetch"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "&Web address of a video or a playlist:", -1, 7, 7, 386, 8
    EDITTEXT   IDC_A_SOURCE, 7, 17, 386, 12, ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP

    LTEXT      "Download &as:", -1, 7, 38, 60, 8
    COMBOBOX   IDC_A_FORMAT, 70, 36, 323, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    LTEXT      "Picture &quality:", -1, 7, 56, 60, 8
    COMBOBOX   IDC_A_QUALITY, 70, 54, 323, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    LTEXT      "Cate&gory:", -1, 7, 74, 60, 8
    COMBOBOX   IDC_A_CATEGORY, 70, 72, 323, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    AUTOCHECKBOX "Save &captions as a file beside the download", IDC_A_CAPTIONS, 7, 90, 386, 10, WS_GROUP | WS_TABSTOP

    LTEXT      "W&hat will happen:", -1, 7, 108, 386, 8
    EDITTEXT   IDC_A_PLAN, 7, 118, 386, 86,
               ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    DEFPUSHBUTTON "&Start downloading", IDOK, 135, 212, 100, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "&Listen without downloading", IDC_A_LISTEN, 7, 212, 124, 14, WS_TABSTOP
    PUSHBUTTON "&Follow the channel instead", IDC_A_FOLLOW, 239, 212, 100, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 343, 212, 50, 14, WS_TABSTOP
END

// The queue (queue in ui.rs): what is running, and what waits its turn. Delete
// removes from the list. Letters: n, w, r, a; Close is Escape or Enter.
IDD_QUEUE DIALOGEX 0, 0, 400, 176
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Queue - VidFetch"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT      "Downloading &now:", -1, 7, 7, 386, 8
    EDITTEXT   IDC_Q_NOW, 7, 17, 386, 12, ES_AUTOHSCROLL | ES_READONLY | WS_GROUP | WS_TABSTOP

    LTEXT      "&Waiting, next first:", -1, 7, 36, 386, 8
    LISTBOX    IDC_Q_LIST, 7, 46, 386, 100,
               LBS_NOTIFY | LBS_WANTKEYBOARDINPUT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_GROUP | WS_TABSTOP

    PUSHBUTTON "&Remove  Delete", IDC_Q_REMOVE, 7, 154, 120, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Remove &all...", IDC_Q_ALL, 133, 154, 120, 14, WS_TABSTOP
    DEFPUSHBUTTON "Close", IDOK, 343, 154, 50, 14, WS_TABSTOP
END

// The Play window (listen.rs): a download's sound. Its title, set at run
// time, names what plays. The arrows, Home and T are handled in listen.rs.
// Letters: p, b, f, w, k; Close is Escape. The keys are in a box of their
// own, as JAWS read them aloud each time the window opened when they were
// plain text at its top (milestone 5 test, 4.1).
IDD_PLAY DIALOGEX 0, 0, 260, 128
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Playing - VidFetch"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON "&Play or pause", IDC_L_PLAY, 7, 52, 120, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "&Back 10 seconds", IDC_L_BACK, 7, 72, 120, 14, WS_TABSTOP
    PUSHBUTTON "&Forward 10 seconds", IDC_L_FORWARD, 133, 72, 120, 14, WS_TABSTOP
    LTEXT      "&Where playing is:", -1, 7, 94, 70, 8
    EDITTEXT   IDC_L_WHERE, 79, 92, 174, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT      "&Keys:", -1, 7, 9, 30, 8
    EDITTEXT   IDC_L_KEYS, 40, 7, 213, 40, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Close", IDCANCEL, 203, 110, 50, 14, WS_TABSTOP
END
